{
    memset(bin_image,  0, sizeof(bin_image));

    memset(l_border, 0, sizeof(l_border));
    memset(r_border, 0, sizeof(r_border));
    memset(mid_line, 0, sizeof(mid_line));

    l_guaidian = 0;
    r_guaidian = 0;

    node_state = NODE_NONE;
    turn_dir = TURN_NONE;
    memset(&path_info, 0, sizeof(PathInfo));
    node_count = 0;

    node_reset = 1;

    image_err = 0.0f;

    yaw_total = 0.0f;
    std_yaw = 0.0f;

    total_dist = 0.0f;

    steer_pwm_out   = 0.0f;
    l_speed_output  = 0.0f;
    r_speed_output  = 0.0f;

    yaw_before_turn = 0.0f;
    yaw_after_turn = 0.0f;
    actual_turn_dir = TURN_NONE;
    turn_verify_flag = 0;
    plan_warn_flag = 0;
}

float image_err = 0.0f;

/**
 * @brief 图像误差计算
 */
void calc_image_error(void)
{
    float err = 0;
    float err_sum = 0;
    static float err_last;

    for (uint8 i = 10; i < ROW; i++)
    {
        err_sum += (mid_line[i] - 89);
    }

    err = err_sum / ROW;

    if (err >= 55)
        err = 55;
    if (err <= -55)
        err = -55;

    image_err = err;
}

/**
 * @brief 连续帧全黑检测，白像素 < 0.5% 且连续 30 帧才触发，跑白线赛道不会误停
 * @return 1=连续全黑/跑出赛道, 0=正常
 */
uint8 is_all_black(void)
{
    static uint8 black_frame_cnt = 0;
    uint32 white_count = 0;

    for (uint16 row = 0; row < ROW; row++)
    {
        for (uint16 col = 0; col < COL; col++)
        {
            if (bin_image[row][col] == WHITE)
            {
                white_count++;
            }
        }
    }

    // 白像素低于 0.5% → 本帧全黑（正常赛道白线远不止112个像素）
    if (white_count < (uint32)(ROW * COL * OUT_OF_TRACK_WHITE_RATIO))
    {
        black_frame_cnt++;
    }
    else
    {
        black_frame_cnt = 0;  // 出现白线就清零
    }

    // 连续全黑帧数超过阈值 → 跑出赛道，停车
    if (black_frame_cnt >= OUT_OF_TRACK_FRAME_CNT)
    {
        black_frame_cnt = 0;
        return 1;
    }
    return 0;
}

void image_proc(void)
{
    if (mt9v03x_finish_flag_1)
    {
        mt9v03x_finish_flag_1 = 0;
        image_binarize(mt9v03x_image_1);
        search_line();
        node_proc(bin_image);
        calc_image_error();
        draw_rect();
    }
}
