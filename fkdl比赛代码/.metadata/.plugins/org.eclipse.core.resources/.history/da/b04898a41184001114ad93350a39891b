const uint8 path_len = ARRAY_LEN(path);

/**
 * @brief 鏍规嵁璺緞瑙勫垝鍜岃妭鐐瑰簭鍙风‘瀹氳浆鍚戞柟鍚�
 */
TurnDir plan_turn(void)
{
    uint8 index = node_count % path_len;
    TurnDir planned = path[index];

    plan_warn_flag = 0; // 榛樿鏃犺鍛�

    // 楠岃瘉璺緞鏄惁瀛樺湪
    if (planned == TURN_LEFT && path_info.left_exist)
        return TURN_LEFT;
    if (planned == TURN_RIGHT && path_info.right_exist)
        return TURN_RIGHT;
    if (planned == GO_STRAIGHT && path_info.top_exist)
        return GO_STRAIGHT;

    // 鑻ヨ繍琛屽埌杩欓噷璇存槑锛氳鍒掔殑鏂瑰悜鍦ㄥ浘鍍忎腑娌℃湁妫�娴嬪埌瀵瑰簲鐨勮矾
    plan_warn_flag = 1; // 鏍囪璀﹀憡
    return planned;
}

/**
 * @brief 鍦ㄦ棤璺緞瑙勫垝涓嬶紝鏍规嵁寤朵几鏂瑰悜纭畾杞悜绛栫暐
 */
TurnDir corner_turn(void)
{
    // 涓嬫柟 + 宸﹁竟鏈夎矾 鈫� 宸﹁浆
    if (path_info.bottom_exist && path_info.left_exist && !path_info.right_exist)
        return TURN_LEFT;

    // 涓嬫柟 + 鍙宠竟鏈夎矾 鈫� 鍙宠浆
    if (path_info.bottom_exist && path_info.right_exist && !path_info.left_exist)
        return TURN_RIGHT;

    return TURN_NONE;
}

