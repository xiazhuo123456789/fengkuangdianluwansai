{
    if (mt9v03x_finish_flag_1)
    {
        mt9v03x_finish_flag_1 = 0;
        image_binarize(mt9v03x_image_1);
        search_line();
        node_proc(bin_image);
        calc_image_error();
        draw_rect();
    }
}
