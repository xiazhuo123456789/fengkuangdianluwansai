/**
 * @brief 鑺傜偣澶勭悊
 */
void node_proc(uint8 (*bin_image)[COL])
{
    static float yaw_target = 0.0f;     // 杞悜鐩爣鍋忚埅瑙�
    static uint8 yaw_locked = 0;        // 鍋忚埅瑙掗攣瀹氭爣蹇�
    static uint8 cur_paths = 0;         // 褰撳墠鑺傜偣璺緞鏁伴噺
    static uint32 enter_tick = 0;       // 鐩磋杩涘叆鏃跺埢(ms)
    static uint8  tick_locked = 0;      // 鐩磋璁℃椂閿佸畾鏍囧織

    if (node_reset)
    {
        yaw_target = 0.0f;
        yaw_locked = 0;
        cur_paths = 0;
        tick_locked = 0;
        node_reset = 0;
        return;
    }

    switch (node_state)
    {
        case NODE_NONE:
            find_guaidian(ROW - 5, 40);

            // 濡傛灉妫�娴嬪埌鎷愮偣
            if (l_guaidian != 0 || r_guaidian != 0)
            {
                uint8 path_count = find_rect_path(bin_image);

                // 褰撳墠涓虹洿瑙�
                if (path_count == 2)
                {
                    turn_dir = corner_turn();

                    // 路径表跑完之后，直角也算路口
                    if (turn_dir != TURN_NONE && node_count >= path_len)
                    {
                        node_count++;
                    }
                }
                // 褰撳墠涓篢瀛楁垨鍗佸瓧璺彛
                else if (path_count >= 3)
                {
                    turn_dir = plan_turn();
                    node_count++;
                }

                if (turn_dir != TURN_NONE)
                {
                    cur_paths = path_count;
                    node_state = NODE_DETECTED;
                }
            }
            break;

        case NODE_DETECTED:
            if (!yaw_locked)
            {
                if (turn_dir == TURN_LEFT)
                {
                    std_yaw -= 90.0f;
                    yaw_target = std_yaw;
                }
                else if (turn_dir == TURN_RIGHT)
                {
                    std_yaw += 90.0f;
                    yaw_target = std_yaw;
                }
                else if (turn_dir == GO_STRAIGHT)
                {
                    yaw_target = std_yaw;
                }
                yaw_before_turn = yaw_total;
                yaw_locked = 1;
                node_state = NODE_TURNING;
            }
            break;

        case NODE_TURNING:
            find_guaidian(ROW - 5, 30);

            if (turn_dir == GO_STRAIGHT)
            {
                // --- 鐩磋澶勭悊锛堟绉掕鏃�+璺緞鎭㈠锛�---

                if (!tick_locked)
                {
                    enter_tick = system_getval_ms();
                    tick_locked = 1;
                }

                uint32 elapsed = system_getval_ms() - enter_tick;

                // 瓒呰繃20ms涓旇矾寰勬暟鎭㈠ < 3 鈫� 閫�鍑�
                if (elapsed > 10 && find_rect_path(bin_image) < 3)
                {
                    yaw_after_turn = yaw_total;
                    float delta_yaw = yaw_after_turn - yaw_before_turn;
                    if (delta_yaw < -30.0f)
                        actual_turn_dir = TURN_LEFT;
                    else if (delta_yaw > 30.0f)
                        actual_turn_dir = TURN_RIGHT;
                    else
                        actual_turn_dir = GO_STRAIGHT;

                    if (actual_turn_dir == turn_dir)
                        turn_verify_flag = 1;
                    else
                        turn_verify_flag = 2;

                    tick_locked = 0;
                    node_reset_state(&yaw_locked, &cur_paths);
                }
            }
            else if (turn_dir == TURN_LEFT)
            {
                // --- 宸﹁浆澶勭悊 ---
                bias_left(bin_image);

                if (yaw_total <= yaw_target + 20.0f)
                {
                    yaw_after_turn = yaw_total;
                    float delta_yaw = yaw_after_turn - yaw_before_turn;
                    // 鍒ゆ柇瀹為檯鏂瑰悜锛歞elta_yaw < 0 涓哄乏杞紝> 0 涓哄彸杞�
                    if (delta_yaw < -30.0f)
                        actual_turn_dir = TURN_LEFT;
                    else if (delta_yaw > 30.0f)
                        actual_turn_dir = TURN_RIGHT;
                    else
                        actual_turn_dir = GO_STRAIGHT;

                    // 鏍￠獙
                    if (actual_turn_dir == turn_dir)
                        turn_verify_flag = 1;  // 鍖归厤
                    else
                        turn_verify_flag = 2;  // 涓嶅尮閰�

                    node_reset_state(&yaw_locked, &cur_paths);
                }
            }
            else if (turn_dir == TURN_RIGHT)
            {
                // --- 鍙宠浆澶勭悊 ---
                bias_right(bin_image);

                if (yaw_total >= yaw_target - 20.0f)
                {
                    yaw_after_turn = yaw_total;
                    float delta_yaw = yaw_after_turn - yaw_before_turn;
                    if (delta_yaw < -30.0f)
                        actual_turn_dir = TURN_LEFT;
                    else if (delta_yaw > 30.0f)
                        actual_turn_dir = TURN_RIGHT;
                    else
                        actual_turn_dir = GO_STRAIGHT;

                    if (actual_turn_dir == turn_dir)
                        turn_verify_flag = 1;
                    else
                        turn_verify_flag = 2;

                    node_reset_state(&yaw_locked, &cur_paths);
                }
            }
            break;

        default:
            break;
    }
}

uint8 node_reset = 0;

/**
 * @brief 鐘舵�佸垵濮嬪寲
 */
void reset_all(void)
{
    memset(bin_image,  0, sizeof(bin_image));

    memset(l_border, 0, sizeof(l_border));
    memset(r_border, 0, sizeof(r_border));
    memset(mid_line, 0, sizeof(mid_line));

    l_guaidian = 0;
    r_guaidian = 0;

    node_state = NODE_NONE;
    turn_dir = TURN_NONE;
    memset(&path_info, 0, sizeof(PathInfo));
    node_count = 0;

    node_reset = 1;

    image_err = 0.0f;

    yaw_total = 0.0f;
    std_yaw = 0.0f;

    total_dist = 0.0f;

    steer_pwm_out   = 0.0f;
    l_speed_output  = 0.0f;
    r_speed_output  = 0.0f;

    yaw_before_turn = 0.0f;
    yaw_after_turn = 0.0f;
    actual_turn_dir = TURN_NONE;
    turn_verify_flag = 0;
    plan_warn_flag = 0;
}

float image_err = 0.0f;

/**
 * @brief 鍥惧儚璇樊璁＄畻
 */
void calc_image_error(void)
{
    float err = 0;
    float err_sum = 0;
    static float err_last;

    for (uint8 i = 10; i < ROW; i++)
    {
        err_sum += (mid_line[i] - 89);
    }

    err = err_sum / ROW;

//    err = err * 0.9f + err_last * 0.1f;
//    err_last = err;

    if (err >= 55)
        err = 55;
    if (err <= -55)
        err = -55;

    image_err = err;
}

