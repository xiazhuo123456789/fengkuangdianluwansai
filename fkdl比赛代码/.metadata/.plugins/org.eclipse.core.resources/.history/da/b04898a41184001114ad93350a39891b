/**
 * @brief 鍒嗗潡澶ф触娉�
 */
uint8 block_otsu(uint8 *image, uint16 col, uint16 row_start, uint16 row_end)
{
    uint32 histogram[256] = {0}; // 鐏板害鐩存柟鍥�
    uint32 pixel_count = 0;      // 鍍忕礌鎬绘暟
    uint32 pixel_sum = 0;        // 鐏板害鎬诲拰

    // 缁熻鐏板害鐩存柟鍥�
    for (uint16 row = row_start; row < row_end; row++)
    {
        for (uint16 col_idx = 0; col_idx < col; col_idx++)
        {
            uint8 gray = image[row * col + col_idx];
            histogram[gray]++;
            pixel_count++;
            pixel_sum += gray;
        }
    }

    // 鎵惧埌鏈夋晥鐏板害鑼冨洿
    uint8 min_gray = 0, max_gray = 255;
    for (min_gray = 0; min_gray < 256 && histogram[min_gray] == 0; min_gray++)
        ;
    for (max_gray = 255; max_gray > min_gray && histogram[max_gray] == 0; max_gray--)
        ;

    // 杈圭晫鎯呭喌澶勭悊
    if (max_gray == min_gray)
        return max_gray;
    if (min_gray + 1 == max_gray)
        return min_gray;

    // 璁＄畻鏈�浣抽槇鍊�
    float max_variance = 0.0f;
    uint8 best_threshold = min_gray;

    uint32 background_count = 0;
    uint32 background_sum = 0;

    for (uint8 threshold = min_gray; threshold < max_gray; threshold++)
    {
        // 绱鑳屾櫙鍍忕礌
        background_count += histogram[threshold];
        background_sum += histogram[threshold] * threshold;

        // 璁＄畻鍓嶆櫙鍍忕礌
        uint32 foreground_count = pixel_count - background_count;
        if (foreground_count == 0)
            continue;

        uint32 foreground_sum = pixel_sum - background_sum;

        // 璁＄畻鑳屾櫙鍜屽墠鏅殑骞冲潎鐏板害
        float background_mean = (float)background_sum / background_count;
        float foreground_mean = (float)foreground_sum / foreground_count;

        // 璁＄畻绫婚棿鏂瑰樊
        float variance = (float)background_count * foreground_count *
                         (background_mean - foreground_mean) *
                         (background_mean - foreground_mean);

        // 璁板綍鏈�澶ф柟宸搴旂殑闃堝��
        if (variance > max_variance)
        {
            max_variance = variance;
            best_threshold = threshold;
        }
    }

    return best_threshold;
}

static uint8 thresh_update_cnt = 0;
static uint8 thresh_far = 128;
static uint8 thresh_mid = 128;
static uint8 thresh_near = 128;

/**
 * @brief 鍥惧儚浜屽�煎寲
 */
void image_binarize(uint8 (*src_image)[COL])
{
    // 姣�20甯ф洿鏂颁竴娆￠槇鍊�
    if (++thresh_update_cnt >= 15)
    {
        thresh_update_cnt = 0;

        // 鍒嗗潡璁＄畻闃堝��
        thresh_far = block_otsu(src_image[0],  COL, BLOCK_FAR_START, BLOCK_FAR_END);
        thresh_mid = block_otsu(src_image[0],  COL, BLOCK_MID_START, BLOCK_MID_END);
        thresh_near = block_otsu(src_image[0], COL, BLOCK_NEAR_START, BLOCK_NEAR_END);

        // 闃堝�奸檺骞�
        if (thresh_far < THRESH_MIN)
            thresh_far = THRESH_MIN;
        if (thresh_far > THRESH_MAX)
            thresh_far = THRESH_MAX;
        if (thresh_mid < THRESH_MIN)
            thresh_mid = THRESH_MIN;
        if (thresh_mid > THRESH_MAX)
            thresh_mid = THRESH_MAX;
        if (thresh_near < THRESH_MIN)
            thresh_near = THRESH_MIN;
        if (thresh_near > THRESH_MAX)
            thresh_near = THRESH_MAX;
    }

    // 鍒嗗潡浜屽�煎寲
    for (uint16 row = 0; row < ROW; row++)
    {
        uint8 threshold;

        // 鏍规嵁琛屾暟閫夋嫨闃堝��
        if (row < BLOCK_FAR_END)
        {
            threshold = thresh_far;
        }
        else if (row < BLOCK_MID_END)
        {
            threshold = thresh_mid;
        }
        else
        {
            threshold = thresh_near;
        }

        // 浜屽�煎寲澶勭悊
        for (uint16 col = 0; col < COL; col++)
        {
            if (src_image[row][col] > threshold)
            {
                bin_image[row][col] = WHITE;
            }
            else
            {
                bin_image[row][col] = BLACK;
            }
        }
    }
}

uint8 l_border[ROW];
uint8 r_border[ROW];
uint8 mid_line[ROW];

/**
 * @brief 鎵嚎
 */
void search_line(void)
{
    uint8 l_find_flag, r_find_flag;

    // 鍒濆鍖栬竟绾挎暟缁�
    memset(l_border, 0, sizeof(l_border));
    memset(r_border, COL - 1, sizeof(r_border));
    memset(mid_line, COL / 2, sizeof(mid_line));

    for (int16 row = ROW - 1; row >= 0; row--)
    {
        l_find_flag = 0;
        r_find_flag = 0;

        // 宸﹁竟绾挎悳绱細浠庡乏鍚戝彸鎵鹃粦-鐧借烦鍙�
        for (uint8 col = 0; col < COL - 2; col++)
        {
            if (bin_image[row][col] == BLACK && bin_image[row][col + 1] == WHITE)
            {
                l_find_flag = 1;
                l_border[row] = col;
                break;
            }
        }

        // 濡傛灉娌℃湁鎵惧埌宸﹁竟鐣岋紝鍒欏皢宸﹁竟鐣岀疆涓�0
        if (!l_find_flag)
        {
            l_border[row] = 0;
        }

        // 鍙宠竟绾挎悳绱細浠庡彸鍚戝乏鎵鹃粦-鐧借烦鍙�
        for (uint8 col = COL - 1; col >= 2; col--)
        {
            if (bin_image[row][col] == BLACK && bin_image[row][col - 1] == WHITE)
            {
                r_find_flag = 1;
                r_border[row] = col;
                break;
            }
        }

        // 濡傛灉娌℃湁鎵惧埌鍙宠竟鐣岋紝鍒欏皢鍙宠竟鐣岀疆涓� COL - 1
        if (!r_find_flag)
        {
            r_border[row] = COL - 1;
        }

        // 璁＄畻涓嚎
        mid_line[row] = (l_border[row] + r_border[row]) / 2;
    }
}

/**
 * @brief 鍋忕疆鏁扮粍
 */
void change_line(uint8 x1, uint8 y1, uint8 x2, uint8 y2)
{
    uint8 i, a1, a2, temp;
    uint8 hx;

    if (x1 > COL - 1)
        x1 = COL - 1;
    else if (x1 <= 0)
        x1 = 0;
    if (y1 > ROW - 1)
        y1 = ROW - 1;
    else if (y1 <= 0)
        y1 = 0;
    if (x2 > COL - 1)
        x2 = COL - 1;
    else if (x2 <= 0)
        x2 = 0;
    if (y2 > ROW - 1)
        y2 = ROW - 1;
    else if (y2 <= 0)
        y2 = 0;

    a1 = y1;
    a2 = y2;

    if (a1 > a2)
    {
        temp = a1;
        a1 = a2;
        a2 = temp;
    }

    for (i = a1; i <= a2; i++)
    {
        hx = (i - y1) * (x2 - x1) / (y2 - y1) + x1;
        if (hx >= COL)
            hx = COL - 1;
        else if (hx <= 0)
            hx = 0;
        mid_line[i] = hx;
        l_border[i] = hx;
        r_border[i] = hx;
    }
}

uint8 l_guaidian;
uint8 r_guaidian;

/**
 * @brief 妫�娴嬫嫄鐐�
 */
void find_guaidian(uint8 start, uint8 end)
{
    uint8 i, t;
    l_guaidian = 0;
    r_guaidian = 0;

    if (start < end)
    {
        t = start;
        start = end;
        end = t;
    }

    if (start >= ROW - 1 - 5)
        start = ROW - 1 - 5;
    if (end <= 5)
        end = 5;

    for (i = start; i >= end; i--)
    {
        // 妫�娴嬪乏瑙掔偣
        if (l_guaidian == 0 && // 鍙壘绗竴涓鍚堟潯浠剁殑鐐�
            abs(l_border[i] - l_border[i - 5]) >= 50)
        {
            l_guaidian = i;
        }

        // 妫�娴嬪彸瑙掔偣
        if (r_guaidian == 0 && // 鍙壘绗竴涓鍚堟潯浠剁殑鐐�
            abs(r_border[i] - r_border[i - 5]) >= 50)
        {
            r_guaidian = i;
        }

        if (l_guaidian != 0 && r_guaidian != 0)
        {
            break;
        }
    }
}

/**
 * @brief 妫�娴嬫寚瀹氬垪璧涢亾涓嬭竟鐣�
 */
uint8 find_line_bottom(uint8 col, uint8 (*bin_image)[COL])
{
    uint8 track_bottom = 0;

    // 濡傛灉鏈�搴曢儴宸茬粡鏄櫧鑹诧紝鐩存帴杩斿洖 ROW-1
    if (bin_image[ROW - 1][col] == WHITE && bin_image[ROW - 2][col] == WHITE)
    {
        return ROW - 1;
    }

    // 浠庝笅寰�涓婃壂鎻忥紙浠� ROW-1 鍒� 2锛�
    for (uint8 row = ROW - 1; row >= 2; row--)
    {
        // 妫�娴嬭禌閬撲笅杈圭晫锛堣繘鍏ヨ禌閬擄級锛氶粦鈫掔櫧鈫掔櫧
        if (bin_image[row][col] == BLACK &&
            bin_image[row - 1][col] == WHITE &&
            bin_image[row - 2][col] == WHITE)
        {
            track_bottom = row;  // 杩斿洖涓嬭竟鐣屼綅缃�
            break;
        }
    }

    return track_bottom;
}

/**
 * @brief 缁熻鐭╁舰妗嗚禌閬撴暟閲�
 */
uint8 find_rect_path(uint8 (*bin_image)[COL])
{
    // 娓呯┖璺緞淇℃伅
    memset(&path_info, 0, sizeof(PathInfo));

    // 妫�娴嬩笂杈癸紙row=9锛宑ol浠�14鍒�79锛�
    for (uint8 col = RECT_LEFT; col < RECT_RIGHT - 2; col++)
    {
        // 榛�-鐧�-鐧借烦鍙橈紝璇存槑鏈夌櫧绾�
        if (bin_image[RECT_TOP][col] == BLACK &&
            bin_image[RECT_TOP][col + 1] == WHITE &&
            bin_image[RECT_TOP][col + 2] == WHITE)
        {
            path_info.top_exist = 1;
            path_info.count++;
            break; // 鎵惧埌涓�鏉″氨澶熶簡
        }
    }

    // 妫�娴嬩笅杈癸紙row=50锛宑ol浠�14鍒�79锛�
    for (uint8 col = RECT_LEFT; col < RECT_RIGHT - 2; col++)
    {
        if (bin_image[RECT_BOTTOM][col] == BLACK &&
            bin_image[RECT_BOTTOM][col + 1] == WHITE &&
            bin_image[RECT_BOTTOM][col + 2] == WHITE)
        {
            path_info.bottom_exist = 1;
            path_info.count++;
            break;
        }
    }

    // 妫�娴嬪乏杈癸紙col=14锛宺ow浠�9鍒�50锛�
    for (uint8 row = RECT_TOP; row < RECT_BOTTOM - 2; row++)
    {
        if (bin_image[row][RECT_LEFT] == BLACK &&
            bin_image[row + 1][RECT_LEFT] == WHITE &&
            bin_image[row + 2][RECT_LEFT] == WHITE)
        {
            path_info.left_exist = 1;
            path_info.count++;
            break;
        }
    }

    // 妫�娴嬪彸杈癸紙col=79锛宺ow浠�9鍒�50锛�
    for (uint8 row = RECT_TOP; row < RECT_BOTTOM - 2; row++)
    {
        if (bin_image[row][RECT_RIGHT] == BLACK &&
            bin_image[row + 1][RECT_RIGHT] == WHITE &&
            bin_image[row + 2][RECT_RIGHT] == WHITE)
        {
            path_info.right_exist = 1;
            path_info.count++;
            break;
        }
    }

    return path_info.count;
}

