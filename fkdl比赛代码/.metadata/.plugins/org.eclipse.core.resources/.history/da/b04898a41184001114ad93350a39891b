static void bias_left(uint8 (*bin_image)[COL])
{
    uint8 guaidian_row = l_guaidian;

    if (guaidian_row != 0)
    {
        // 鎷愮偣瀛樺湪锛氭嫄鐐逛笂鏂瑰亸缃埌鍒�0 涓嬫柟淇濈暀鍘熷涓嚎
        change_line(0, guaidian_row, 0, 0);
    }
    else
    {
        // 鎷愮偣娑堝け锛氱敤宸︿晶璧涢亾涓嬭竟鐣屾浛浠ｆ嫄鐐�
        uint8 tb = find_line_bottom(0, bin_image);

        if (tb != 0)
        {
            // 涓嬭竟鐣屼笂鏂瑰亸缃埌鍒�0 涓嬫柟淇濈暀鍘熷涓嚎
            change_line(0, tb, 0, 0);
        }
    }
}

/**
 * @brief 涓嚎鍔ㄦ�佸彸鍋�
 */
static void bias_right(uint8 (*bin_image)[COL])
{
    uint8 guaidian_row = r_guaidian;

    if (guaidian_row != 0)
    {
        change_line(COL - 1, guaidian_row, COL - 1, 0);
    }
    else
    {
        uint8 tb = find_line_bottom(COL - 2, bin_image);

        if (tb != 0)
        {
            change_line(COL - 1, tb, COL - 1, 0);
        }
    }
}

